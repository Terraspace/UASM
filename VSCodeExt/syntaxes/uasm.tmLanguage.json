{
  "scopeName": "source.uasm",
  "patterns": [
    { "name": "comment.line.semicolon.uasm", "match": ";.*$" },
    {
      "name": "comment.block.uasm",
      "begin": "(?i)^\\s*COMMENT\\s+(\\S)",
      "end": "\\1"
    },
    {
      "name": "string.quoted.double.uasm",
      "begin": "L?\"",
      "end": "\"",
      "patterns": [
        { "match": "\"\"|\\\\[nrt]", "name": "constant.character.escape.uasm" }
      ]
    },
    {
      "name": "string.quoted.single.uasm",
      "begin": "'",
      "end": "'",
      "patterns": [{ "match": "''", "name": "constant.character.escape.uasm" }]
    },
    {
      "name": "keyword.control.namespace.uasm",
      "match": "(?i)^\\s*(?:NAMESPACE\\s+[\\w@$?]+|ENDNAMESPACE)\\s*(?=;|$)"
    },
    {
      "name": "entity.name.function.uasm",
      "match": "(?i)\\b[\\w@$?]+(?=\\s+(?:PROC|PROTO|MACRO)\\b)"
    },
    {
      "name": "keyword.control.uasm",
      "match": "(?i)\\b(?:STRUCT|STRUC|UNION|ENDS|PROC|ENDP|PROTO|MACRO|ENDM|LOCAL|INVOKE|ASSUME|INCLUDE|INCLUDELIB|TYPEDEF|CLASS|ENDCLASS|METHOD|ENDMETHOD|CMETHOD|CSTATIC|CVIRTUAL|STATICMETHOD|VECMETHOD|ENDMETHODS|COMINTERFACE|ENDCOMINTERFACE|RAWINTERFACE|ENDRAWINTERFACE|OINTERFACE|ENDOINTERFACE|STDFUNC|OPTION|PUBLIC|EXTERN|EXTERNDEF|EQU|TEXTEQU|IFDEF|IFNDEF|ENDIF|ELSE)\\b"
    },
    {
      "name": "storage.type.uasm",
      "match": "(?i)\\b(?:PTR|BYTE|SBYTE|WORD|SWORD|DWORD|SDWORD|QWORD|SQWORD|REAL4|REAL8|REAL10|XMMWORD|YMMWORD|ZMMWORD|DB|DW|DD|DQ|DT)\\b"
    },
    {
      "name": "variable.language.register.uasm",
      "match": "(?i)\\b(?:[RE]?(?:AX|BX|CX|DX|SI|DI|BP|SP)|[ABCD][HL]|R(?:[89]|[12][0-9]|3[01])(?:D|W|B)?|[XYZ]MM[0-9]+|K[0-7]|[CDEFGS]S)\\b"
    },
    {
      "name": "constant.numeric.uasm",
      "match": "\\b(?:0x[0-9a-fA-F]+|[0-9][0-9a-fA-F]*[hH]|[01]+[bB]|[0-9]+(?:\\.[0-9]+)?)\\b"
    },
    {
      "name": "keyword.operator.uasm",
      "match": "::|->|\\b(?i:ADDR|OFFSET|SIZEOF|TYPE|LENGTHOF|NOT|AND|OR|XOR|SHL|SHR)\\b"
    },
    {
      "name": "keyword.control.uasm",
      "match": "(?i)\\.(?:IF|ELSEIF|ELSE|ENDIF|WHILE|ENDW|REPEAT|UNTIL|CODE|DATA|CONST)\\b"
    }
  ]
}
